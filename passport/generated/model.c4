// Generated by scripts/passport.mjs from passport/components/*.json — do not edit.
// Preview: npx likec4 start passport/generated
specification {
  element ui
  element bridge
  element app
  element core
  element data
  element ext
  element delivery
}

model {
  app_android = app 'Android' {
    description 'На Android выбранный файл приходит как content://, а раздавать нужно настоящий файл — он копируется в приватную папку imports/. Пока что-то раздаётся, служба переднего плана с уведомлением «Раздача» не даёт системе заморозить процесс.'
  }
  app_cli = app 'Консольная программа' {
    description 'tikdl get <ссылка> <папка> | serve [--once] [путь ...] | shares | stop <id>: те же функции ядра без окна; serve печатает ссылку и каждую смену этапа одноразовой ссылки.'
  }
  app_commands = app 'Команды окна' {
    description 'Команды, которые вызывает интерфейс: разбор ссылки, «Что внутри?», папка по умолчанию, входящие ссылки, список и запуск, пауза, удаление загрузок, раздать, список, остановить, новая ссылка.'
  }
  app_jobs = app 'Задачи загрузки' {
    description 'Одна задача на загрузку: подключение, узнать размер, проверить место, скачать, progress раз в 250 мс со скоростью за 5 с, итог в downloads.json. Для одноразовой ссылки — сообщить отправителю «получено» (5 попыток, потом при следующем запуске).'
  }
  app_shell = app 'Запуск и строка меню' {
    description 'Точка входа: консольный режим или окно; плагины Tauri; один экземпляр; значок в строке меню («Открыть TikDL», «Выйти из TikDL»); ссылки tikdl:// в очередь; старт узла, продолжение загрузок, отправка отложенных «получено»; события node-ready, node-error, links-pending, shares-changed; закрыть окно = спрятать; уведомление «Готово».'
  }
  app_state = app 'Реестр загрузок' {
    description 'AppState: узел (запускается один раз, лениво), задачи загрузки, очередь входящих ссылок. Реестр downloads.json переживает перезапуск: ссылка, папка, состояние, ожидание «получено» для одноразовых.'
  }
  core_download = core 'Загрузка и выкладка' {
    description '«Что внутри?» (имена и проверенные размеры без скачивания), проверка места до первого байта, загрузка в downloads/ под тегом dl-<id>, проверка имён, выкладка каждого верхнего элемента во временное имя и переименование, снятие тега.'
  }
  core_links = core 'Ссылки' {
    description 'Формат ссылки: tikdl://get/blob… (обычная: ключ узла + relay, ?size, ?name) и tikdl://get/once… (одноразовая); https-обёртка для мессенджеров (TIKDL_LINK_BASE); разбор любой из них и голого тикета.'
  }
  core_node = core 'Узел' {
    description 'Запуск и остановка узла iroh: папка данных, ключ узла (0600, испорченный откладывается), два хранилища (store/ — раздачи, downloads/ — загрузки), сохранённый порт, сборщик мусора, ожидание связи с relay.'
  }
  core_once = core 'Одноразовые ссылки' {
    description 'Временный узел со своим ключом на каждую ссылку; закрепление за первым устройством (claim, запись на диск до ответа), шлюз над iroh-blobs только для этого устройства и этих хешей, «получено» → ссылка сгорает и узел выключается; сроки 3 дня без закрепления и 7 дней без активности; не больше 10 сразу; «Новая ссылка».'
  }
  core_paths = core 'Пути и запреты' {
    description 'Безопасные имена из чужой раздачи (без ../, C:, CON…), имя без перезаписи («имя (1)»), временное .tikdl-part, скрытые файлы, запись только для владельца, запрет раздачи системного диска и папок, домашней папки целиком, ключей программ, папки TikDL.'
  }
  core_share = core 'Раздача' {
    description 'Раздать файл или папку: проверить запрет, обойти папку (скрытое пропускается), посчитать и сохранить в store/, тег share-<id>, ссылка, запись в shares.json. Белый список хешей, которые основной узел отдаёт в сеть. Список, остановка, проверка «файлы изменились».'
  }
  data_key = data 'Ключ узла и порт' {
    description 'node.key — секретный ключ узла (из него id в обычных ссылках); port — сохранённый порт, чтобы старые ссылки находили узел быстрее.'
  }
  data_registry = data 'Реестр загрузок' {
    description 'downloads.json: загрузки окна (ссылка, папка, состояние, имя, ack_pending для одноразовых).'
  }
  data_shares = data 'Список раздач' {
    description 'shares.json: раздачи (путь, хеш, участники, время), для одноразовых — ключ временного узла, хеш токена, закреплённое устройство, этап.'
  }
  data_store = data 'Хранилища блобов' {
    description 'store/ — раздачи (в сеть отдаётся только оно, по белому списку); downloads/ — загрузки до выкладки (к сети не подключено); теги share-* и dl-* защищают от сборщика мусора.'
  }
  delivery_checks = delivery 'Проверки и сборка' {
    description 'ui_check (ворота кода интерфейса), ui_smoke (экраны открываются без ошибок, снимки), ESLint (слои), паспорт (сверка карты с кодом), build.rs Tauri.'
  }
  delivery_ci = delivery 'GitHub Actions' {
    description 'build.yml: проверки и сборка dmg/exe/deb/apk на каждый push; pages.yml: публикует страницу-прокладку ui/site на GitHub Pages.'
  }
  ext_iroh = ext 'iroh и iroh-blobs' {
    description 'Сеть узлов по ключу (iroh 1.5): прямое соединение с пробиванием NAT или через relay; iroh-blobs 0.105: проверяемая передача блобов, хранилище FsStore, сборщик мусора.'
  }
  ext_os = ext 'Система' {
    description 'Уведомления, строка меню, диалоги выбора файлов, регистрация tikdl://, «Показать в Finder»; на Android — ContentResolver и служба переднего плана.'
  }
  ext_peer = ext 'Другой TikDL' {
    description 'Компьютер раздающего или получающего: отвечает на запросы блобов и на протокол tikdl/once/1.'
  }
  ext_relay = ext 'Relay и pkarr (n0)' {
    description 'Общедоступные серверы n0: relay помогает найти узел и пересылает данные, пока нет прямого пути; pkarr публикует адрес временного узла, чтобы ссылка пережила перезапуск отправителя.'
  }
  ui_api = bridge 'Мост к Rust' {
    description 'Обёртка над invoke/listen Tauri: по функции на каждую команду, api.on для событий, диалоги выбора файлов, перетаскивание, «Показать в Finder», копирование. Вне Tauri подставляет мок.'
  }
  ui_kit = ui 'Кит интерфейса' {
    description 'Общие элементы: кнопки, поля, переключатель, вкладки, строка передачи с полосой, ярлык состояния, значки, раскладка. Только вид, без данных.'
  }
  ui_mock = bridge 'Мок ядра для браузера' {
    description 'Поддельные ответы всех команд и событий: интерфейс и витрина открываются в обычном браузере без Rust, ui_smoke снимает экраны.'
  }
  ui_screens = ui 'Экраны' {
    description 'Вкладка «Скачать»: поле ссылки, папка, карточка подтверждения входящей ссылки, строки загрузок с паузой и удалением. Вкладка «Раздать»: выбор файлов или папки, переключатель «Одноразовая ссылка», строки раздач со ссылкой, «Новая ссылка», «Остановить».'
  }
  ui_shell = ui 'Оболочка окна' {
    description 'Каркас окна: вкладки «Скачать» и «Раздать», баннер «Сеть не запустилась», слой перетаскивания файлов, маршрут витрины #/kit. Запускает boot() состояния.'
  }
  ui_showcase = ui 'Витрина кита' {
    description 'Страница #/kit: каждый элемент кита во всех состояниях, плюс строки загрузок и раздач на настоящих функциях вида из ui.state.'
  }
  ui_site = ui 'Страница для ссылок' {
    description 'https-ссылка https://<owner>.github.io/<repo>/get/#<тикет>: мессенджер делает её кликабельной, страница открывает tikdl://get/<тикет>. Тикет после «#» на сервер не уходит. Принимает обычные и одноразовые ссылки.'
  }
  ui_state = bridge 'Состояние интерфейса' {
    description 'Единственный источник данных экранов: список загрузок и раздач, очередь входящих ссылок, тексты строк (downloadView, shareView, этапы одноразовой ссылки), действия кнопок. Подписывается на события Rust.'
  }
  app_android -> core_share 'вызов'
  app_android -> ext_os 'JNI'
  app_cli -> core_node 'вызов'
  app_cli -> core_share 'вызов'
  app_cli -> core_download 'вызов'
  app_cli -> core_links 'вызов'
  app_cli -> core_once 'вызов'
  app_commands -> app_state 'вызов'
  app_commands -> core_node 'вызов'
  app_commands -> app_jobs 'вызов'
  app_commands -> core_links 'вызов'
  app_commands -> core_download 'вызов'
  app_commands -> core_share 'вызов'
  app_commands -> core_once 'вызов'
  app_commands -> app_android 'вызов'
  app_commands -> ui_api 'событие'
  app_jobs -> app_state 'вызов'
  app_jobs -> core_links 'вызов'
  app_jobs -> core_download 'вызов'
  app_jobs -> core_once 'вызов'
  app_jobs -> app_shell 'вызов'
  app_jobs -> ui_api 'событие'
  app_shell -> app_cli 'вызов'
  app_shell -> core_once 'ложная связь'
  app_shell -> app_state 'вызов'
  app_shell -> app_jobs 'вызов'
  app_shell -> app_commands 'регистрация'
  app_shell -> app_android 'вызов'
  app_shell -> core_node 'вызов'
  app_shell -> core_links 'вызов'
  app_shell -> ui_api 'событие'
  app_shell -> ext_os 'система'
  app_state -> core_node 'вызов'
  app_state -> core_paths 'вызов'
  app_state -> data_registry 'чтение и запись'
  core_download -> core_paths 'вызов'
  core_download -> core_once 'ложная связь'
  core_download -> ext_peer 'сеть'
  core_download -> data_store 'запись'
  core_links -> core_once 'вызов'
  core_node -> core_paths 'вызов'
  core_node -> core_share 'вызов'
  core_node -> core_once 'вызов'
  core_node -> ext_iroh 'библиотека'
  core_node -> data_key 'чтение и запись'
  core_node -> data_store 'открывает'
  core_once -> core_node 'вызов'
  core_once -> core_share 'вызов'
  core_once -> ext_iroh 'библиотека'
  core_once -> ext_relay 'сеть'
  core_once -> data_shares 'запись'
  core_share -> core_paths 'вызов'
  core_share -> core_links 'вызов'
  core_share -> core_once 'вызов'
  core_share -> core_node 'вызов'
  core_share -> data_shares 'чтение и запись'
  core_share -> data_store 'запись'
  delivery_ci -> delivery_checks 'запуск'
  delivery_ci -> ui_site 'публикация'
  ui_api -> app_commands 'IPC'
  ui_api -> ui_mock 'импорт'
  ui_screens -> ui_kit 'импорт'
  ui_screens -> ui_state 'импорт'
  ui_shell -> ui_kit 'импорт'
  ui_shell -> ui_screens 'импорт'
  ui_shell -> ui_state 'импорт'
  ui_shell -> ui_showcase 'импорт'
  ui_showcase -> ui_kit 'импорт'
  ui_showcase -> ui_state 'импорт'
  ui_site -> app_shell 'deep link'
  ui_state -> ui_api 'импорт'
}

views {
  view index {
    include *
  }
}
